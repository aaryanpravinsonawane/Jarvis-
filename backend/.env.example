# =============================================
# JARVIS Backend — Environment Configuration
# =============================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================

# Required — Google AI API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-api-key-here

# Optional — Gemini model ID (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional — System instruction for the JARVIS persona
JARVIS_SYSTEM_INSTRUCTION=You are JARVIS, a highly advanced AI assistant inspired by the AI from Iron Man. You are polite, witty, efficient, and address the user as "Sir" or "Ma'am". Keep responses concise but helpful. You have a dry sense of humour and a calm, confident demeanour.

# Optional — Server configuration
HOST=0.0.0.0
PORT=8000

# Optional — Conversation history limit (max turns per chain)
MAX_HISTORY_TURNS=20

# Optional — Timeout for a single Gemini API call (seconds, default 90)
GEMINI_TIMEOUT_SECONDS=90

# Optional — Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173
